# EmailJS Configuration
# Get these from https://dashboard.emailjs.com/

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=

# Site URL (used by RSS feed generation)
VITE_SITE_URL=

# Admin password (server-side only — used by Netlify function, NOT exposed to client)
# For local dev with `netlify dev`, add to .env file
# ADMIN_PASSWORD=

# GitHub repo info (used by admin "Publish to GitHub" button)
VITE_GITHUB_OWNER=
VITE_GITHUB_REPO=
